{
  "name": "figaro-forms",
  "version": "0.24.8",
  "description": "Subscribable figaro form state: store, optimistic edits, auth, view model, React and Jotai bindings",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./glyphs": {
      "types": "./dist/glyphs.gen.d.ts",
      "default": "./dist/glyphs.gen.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./semantics": {
      "types": "./dist/semantics/well-known.d.ts",
      "default": "./dist/semantics/well-known.js"
    },
    "./view": {
      "types": "./dist/view/flatten.d.ts",
      "default": "./dist/view/flatten.js"
    },
    "./hierarchy": {
      "types": "./dist/hierarchy/index.d.ts",
      "default": "./dist/hierarchy/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./jotai": {
      "types": "./dist/jotai/index.d.ts",
      "default": "./dist/jotai/index.js"
    },
    "./aria": {
      "types": "./dist/aria/index.d.ts",
      "default": "./dist/aria/index.js"
    },
    "./aria/react": {
      "types": "./dist/aria/react.d.ts",
      "default": "./dist/aria/react.js"
    },
    "./aria/jotai": {
      "types": "./dist/aria/jotai.d.ts",
      "default": "./dist/aria/jotai.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:daemon": "vitest run -c vitest.daemon.config.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jotai": "^3.0.2",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "peerDependencies": {
    "jotai": ">=2.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "jotai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
